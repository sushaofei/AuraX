# Copy to .env.test on DEV_WEB (10.244.16.130). Do not commit .env.test.
#
# docker compose --env-file .env.test -f compose.test.yml up --build -d

# Built image tag on the server.
AURAX_IMAGE=aurax:test

# Host port published by compose (container listens on 80). Keep off :80 — that is the site homepage.
AURAX_HTTP_PORT=1420

# AuraClaw ingress on DEV_SERVICE. nginx proxies /v1 and /health/ready here.
AURACLAW_UPSTREAM=http://10.244.16.131:8080
